// Root window skeleton, extended through IMPL_UI_SHELL.md Phase 2. Phase 1 proved the Slint/tokio
// bridge (see src/core_bridge.rs) delivers live `ConnectionState` transitions to the UI thread.
// Phase 2 adds the zone list (`zones`/`selectedZoneId`) in the sidebar's spot — a temporary home;
// real browse categories (Phase 4) and/or a transport-bar-triggered zone-switcher popover (a
// possible Phase 3 follow-up) may eventually displace it, per IMPL_UI_SHELL.md's Phase 2 notes.
// Regions are still otherwise flat rectangles colored with DESIGN.md's sampled dark-theme tokens —
// a proper light/dark palette singleton is still open, not pulled forward here.
struct ZoneInfo {
    zoneId: string,
    displayName: string,
    state: string,
}

export component AppWindow inherits Window {
    title: "Dissonanza";
    preferred-width: 1024px;
    preferred-height: 720px;
    background: #161616; // DESIGN.md dark --bg

    in-out property <string> connectionStatus: "Not started";
    in property <[ZoneInfo]> zones: [];
    in-out property <string> selectedZoneId: "";

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: #222222; // DESIGN.md dark --surface

            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "Zones";
                    color: #919191; // DESIGN.md dark --text-secondary
                    font-size: 12px;
                    font-weight: 600;
                }

                for zone in root.zones: Rectangle {
                    height: 44px;
                    border-radius: 4px;
                    background: zone.zoneId == root.selectedZoneId ? #3A3C68 : transparent; // DESIGN.md dark --accent-selected-bg

                    TouchArea {
                        clicked => {
                            root.selectedZoneId = zone.zoneId;
                        }
                    }

                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: zone.displayName;
                            color: zone.zoneId == root.selectedZoneId ? #686CD5 : #ffffff; // DESIGN.md dark --accent / --text-primary
                        }

                        Text {
                            text: zone.state;
                            color: #919191; // DESIGN.md dark --text-secondary
                            font-size: 11px;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            Rectangle {
                background: #161616; // DESIGN.md dark --bg

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "Content area (placeholder)";
                        color: #919191; // DESIGN.md dark --text-secondary
                    }

                    Text {
                        text: "Connection: " + root.connectionStatus;
                        color: #ffffff; // DESIGN.md dark --text-primary
                        font-size: 20px;
                    }
                }
            }

            Rectangle {
                height: 96px;
                background: #222222; // DESIGN.md dark --surface

                VerticalLayout {
                    padding: 12px;
                    alignment: start;

                    Text {
                        text: "Now-playing bar (placeholder)";
                        color: #919191; // DESIGN.md dark --text-secondary
                    }
                }
            }
        }
    }
}
